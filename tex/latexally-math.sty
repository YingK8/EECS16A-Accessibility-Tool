%% latexally-math.sty
%% Spoken alt text for every tagged formula.
%% Without it latex-lab fills /Alt with the raw LaTeX source, which a screen
%% reader reads out character by character.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{latexally-math}
  [2026/08/21 v1.0 latexally spoken math alt text]

\ExplSyntaxOn

\tl_new:N \l__latexally_math_hash_tl
\tl_new:N \l__latexally_math_speech_tl

\cs_if_exist:NT \tagpdfsetup { \tagpdfsetup{ math/mathml/write-dummy } }

\AddToHook{begindocument}
  { \cs_if_exist:NT \tagpdfsetup { \tagpdfsetup{ math/alt/use = true } } }

\AddToHook{begindocument}
  {
    \file_if_exist:nT { \c_sys_jobname_str-mathspeech.ltx }
      { \file_input:n { \c_sys_jobname_str-mathspeech.ltx } }
  }

\tl_if_exist:NT \l__math_content_alt_tl
  {
    \socket_new_plug:nnn
      { tagsupport/math/content }
      { latexally-speech }
      {
        \tl_set:Ne \l__math_content_AF_source_tl { \l__math_texsource_template_tl }
        \tl_set:Ne \l__latexally_math_hash_tl
          { \str_mdfive_hash:o { \l__math_content_AF_source_tl } }
        \tl_if_exist:cTF { g__latexally_speech_ \l__latexally_math_hash_tl _tl }
          {
            \tl_set:Ne \l__latexally_math_speech_tl
              { \tl_use:c { g__latexally_speech_ \l__latexally_math_hash_tl _tl } }
            \tl_set:Ne \l__math_content_alt_tl { \l__latexally_math_speech_tl }
          }
          {
            \tl_set:Nn \l__math_content_alt_tl {}
            \tl_clear:N \l__latexally_math_speech_tl
          }
        \tl_set:Nn \l__math_content_AF_mathml_tl {}
        \tl_set:Nn \l__math_content_actual_tl    {}
      }
    \socket_assign_plug:nn { tagsupport/math/content } { latexally-speech }
  }

\cs_new_protected:Npn \__latexally_math_reopen_mc:
  {
    \tl_if_empty:NF \l__latexally_math_speech_tl
      {
        \tag_mc_end:
        \exp_args:Ne \tag_mc_begin:n
          { actualtext = { \l__latexally_math_speech_tl } }
      }
  }

\socket_if_exist:nT { tagsupport/math/inline/formula/begin }
  {
    \socket_new_plug:nnn
      { tagsupport/math/inline/formula/begin }
      { latexally-speech }
      {
        \tagpdfparaOff
        \__math_luamml_structelem:
        \tag_socket_use:n { math/content }
        \tag_socket_use:n { math/struct/begin }
        \__latexally_math_reopen_mc:
        #2
        \tag_socket_use:n { math/end }
      }
  }
\socket_if_exist:nT { tagsupport/math/display/formula/begin }
  {
    \socket_new_plug:nnn
      { tagsupport/math/display/formula/begin }
      { latexally-speech }
      {
        \tagpdfparaOff
        \__math_luamml_structelem:
        \tag_socket_use:n { math/content }
        \tag_socket_use:n { math/struct/begin }
        \__latexally_math_reopen_mc:
        #2
        \tag_socket_use:n { math/end }
      }
  }

\AddToHook{begindocument}
  {
    \socket_if_exist:nT { tagsupport/math/inline/formula/begin }
      { \socket_assign_plug:nn
          { tagsupport/math/inline/formula/begin } { latexally-speech } }
    \socket_if_exist:nT { tagsupport/math/display/formula/begin }
      { \socket_assign_plug:nn
          { tagsupport/math/display/formula/begin } { latexally-speech } }
  }

\ExplSyntaxOff
\endinput
