%% latexally-compat-ee16.sty
%% Compatibility shim: the legacy EECS 16A macro vocabulary re-expressed in
%% terms of tagged primitives, so existing question files keep compiling.

\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesExplPackage{latexally-compat-ee16}{2026-08-08}{0.1.0}
  {Legacy EECS 16A macro compatibility}

\RequirePackage{latexally-doc}

%% Questions and parts

\ProvideDocumentCommand \qns { m } { \question {#1} }
\ProvideDocumentCommand \q   { m m } { \question [#1] {#2} }

\ProvideDocumentCommand \qpart { } { }

\ProvideDocumentCommand \qitem { }
  {
    \int_compare:nNnT { \use:c { @listdepth } } > { 0 } { \item [ ] }
    \questionpart
  }

%% Solution / answer blocks

\ProvideDocumentCommand \sol    { +m } { \begin{solution} #1 \end{solution} }
\ProvideDocumentCommand \solans { +m } { \begin{solution} #1 \end{solution} }
\ProvideDocumentCommand \ans    { +m } { \begin{answer}   #1 \end{answer} }

%% Containers

\ProvideDocumentEnvironment { qunlist } { } { \par } { \par }

%% Legacy figure inclusion

\ProvideDocumentCommand \fig { O{} m }
  { \described {#1} { \includegraphics{#2} } }

\ProvideDocumentCommand \twofig { O{} O{} m m }
  {
    \par\noindent
    \described {#1} { \includegraphics[width=0.48\linewidth]{#3} }
    \hfill
    \described {#2} { \includegraphics[width=0.48\linewidth]{#4} }
    \par
  }

%% Fill-in blanks

\ProvideDocumentCommand \fillin { O{4cm} } { \answerblank [#1] }
\ProvideDocumentCommand \doublehrule { }
  { \begin{Decorative} \hrule \vskip 0.02in \hrule \end{Decorative} }

%% Deprecated spellings of the description API

\msg_new:nnn { latexally } { deprecated-name }
  { '#1'~is~deprecated;~use~'#2'~instead. }

\cs_new_protected:Npn \__access_compat_warn:nn #1#2
  {
    \msg_warning:nnee { latexally } { deprecated-name }
      { \tl_to_str:n {#1} } { \tl_to_str:n {#2} }
  }

\ProvideDocumentEnvironment { AltOnly } { s m }
  {
    \__access_compat_warn:nn { AltOnly } { Described }
    \IfBooleanTF {#1} { \Described* {#2} } { \Described {#2} }
  }
  { \endDescribed }

\ProvideDocumentCommand \altonly { m +m }
  { \__access_compat_warn:nn { \altonly } { \described }
    \described {#1} {#2} }

\keys_define:nn { latexally / figure }
  { alt .meta:n = { description = {#1} } }

\ProvideDocumentEnvironment { FigureBlock } { O{} }
  {
    \__access_compat_warn:nn { FigureBlock } { DescribedFigure }
    \DescribedFigure [#1]
  }
  { \endDescribedFigure }

\ProvideDocumentCommand \FigureDescription { +m }
  { \__access_compat_warn:nn { \FigureDescription } { \LongDescription }
    \LongDescription [Figure~description] {#1} }

%% Argument-less \title recovery

\AddToHook { begindocument }
  {
    \tl_if_empty:NT \g__access_doctitle_tl
      {
        \cs_if_exist:NT \title
          {
            \str_if_eq:eeT { \cs_argument_spec:N \title } { }
              {
                \tl_gset:Nx \g__access_doctitle_tl { \title }
                \exp_args:NV \accesstitle \g__access_doctitle_tl
              }
          }
      }
  }

\endinput
