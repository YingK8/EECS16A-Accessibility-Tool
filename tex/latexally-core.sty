%% latexally-core.sty
%% Part of latexally — https://github.com/YingK8/EECS16A-Accessibility-Tool
%% SPDX-License-Identifier: MIT
%%
%% Accessibility primitives for tagged PDF output: strict alt text, tagged
%% headings with bookmarks, accessible tables, and a WCAG-conforming palette.
%%
%% ---------------------------------------------------------------------------
%% THE CENTRAL MECHANISM: Described
%% ---------------------------------------------------------------------------
%% The requirement is "wrap an arbitrary region so assistive technology reads
%% ONLY a supplied alt string, never the region's real contents". Three
%% mechanisms could plausibly do that; only one actually works.
%%
%%   /ActualText   Spec-correct ("a replacement, not a description",
%%                 ISO 32000-1 14.9.4) and implementation-broken. Measured
%%                 support (ho-tex/accsupp#2): Acrobat rejects long strings and
%%                 returns random substrings; Chrome truncates at 16383 chars and
%%                 strips newlines; Firefox, MuPDF < 1.27, PDF-XChange and
%%                 SumatraPDF ignore it entirely. Marked-content ActualText also
%%                 CANNOT NEST, so it cannot wrap a region containing any other
%%                 tagged construct. Rejected.
%%
%%   /Alt alone    A description, not a replacement. Reliable on a Figure whose
%%                 content has no text kids -- but on its own it does not stop a
%%                 reader descending into tagged content inside the region.
%%
%%   Artifact      Content marked as an artifact is by definition not real
%%                 content: it is absent from the structure tree and every
%%                 reader skips it unconditionally. This is the only 100%
%%                 reliable suppression primitive in PDF.
%%
%% Described therefore combines the last two, which is exactly the construction
%% tagpdf itself uses for TikZ pictures (see tagpdfdocu-patches.sty): open one
%% Figure structure element carrying /Alt, open a single marked-content leaf,
%% then SUSPEND TAGGING for the body. Suspension stops structure creation and
%% paragraph counting, so nothing inside can register itself in the tag tree.
%% The reader reaches the /Alt and nothing else.
%%
%% Page breaks are the one real limit: a marked-content sequence cannot cross a
%% page boundary. The unstarred environment therefore places its body in an
%% unbreakable box, which guarantees a single well-formed MC leaf. Use the
%% starred form only for regions that must break, and read the warning it emits.

\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesExplPackage{latexally-core}{2026-08-08}{0.1.0}
  {Strict alt text, tagged headings and accessible tables}

\RequirePackage{xcolor}

%% Bookmarks need a mechanism, and not every document has one.
%%
%% Tagging never writes /Outlines -- the structure tree and the bookmark tree
%% are separate object graphs -- so bookmarks come from hyperref's \pdfbookmark
%% or the bookmark package. The EECS 16A homework drivers happen to load
%% hyperref; the discussion-worksheet preamble does not. Without this line those
%% worksheets tagged perfectly (258 structure objects) and produced ZERO
%% bookmarks, with no error and no warning: a silent loss of the navigation this
%% package exists to provide.
%%
%% `bookmark` pulls in hyperref if it is not already loaded, so it is loaded at
%% the END of the preamble rather than here. Loading it immediately would take
%% hyperref with no options, and a later `\usepackage[colorlinks=true]{hyperref}`
%% in the document -- which sp26/dis/03A/body03A.tex really does -- then fails
%% with "Option clash for package hyperref". Deferring lets the document's own
%% options win, and makes this a no-op when hyperref is already present.
\AddToHook{begindocument/before}{\RequirePackage{bookmark}}

%% ---------------------------------------------------------------------------
%% 0. Graceful degradation
%% ---------------------------------------------------------------------------
%% tagpdf-base defines no-op stubs for all of these, and the kernel defines
%% SuspendTagging/ResumeTagging as no-ops until tagging is activated. The
%% providecommands below only matter on a kernel older than we support: they
%% keep a document compiling (untagged) rather than erroring out.

\providecommand \tagstructbegin [1] {}
\providecommand \tagstructend       {}
\providecommand \tagmcbegin    [1] {}
\providecommand \tagmcend           {}
\providecommand \tagpdfsetup   [1] {}
\providecommand \SuspendTagging[1] {}
\providecommand \ResumeTagging [1] {}

\bool_new:N \l__access_tagging_bool
\bool_new:N \g__access_strict_bool
\bool_gset_true:N \g__access_strict_bool

%% Is tagging actually switched on right now? Asked at use time, not load time,
%% because \DocumentMetadata activates it after this package is read.
\cs_new_protected:Npn \__access_if_tagging:TF #1#2
  {
    \cs_if_exist:NTF \tag_if_active:TF
      { \tag_if_active:TF {#1} {#2} }
      {#2}
  }

%% ---------------------------------------------------------------------------
%% 1. Messages
%% ---------------------------------------------------------------------------

\msg_new:nnnn { latexally } { alt-empty }
  { Empty~alt~text~for~a~#1. }
  {
    A~Figure~structure~element~with~an~empty~/Alt~is~a~PDF/UA-1~failure~
    (Matterhorn~13-004),~not~an~exemption.~If~this~graphic~is~decorative,~use~
    the~Decorative~environment~instead,~which~marks~it~as~an~artifact.
  }

\msg_new:nnnn { latexally } { alt-placeholder }
  { Unfilled~alt-text~placeholder:~'#1'. }
  {
    A~placeholder~would~ship~into~the~PDF~as~real~/Alt~text.~A~screen~reader~
    would~announce~it~verbatim,~and~-- worse -- the~document~would~PASS~a~naive~
    "every~Figure~has~/Alt"~check~and~veraPDF,~producing~a~silent~false~
    conformance~claim.~Fill~in~the~description~before~building.
  }

\msg_new:nnnn { latexally } { alt-is-filename }
  { Alt~text~looks~like~a~file~name:~'#1'. }
  {
    Announcing~"vehicle~setup~dot~pdf"~tells~a~student~nothing.~Describe~what~
    the~graphic~shows.~Note~that~latex-lab~uses~the~file~name~as~its~DEFAULT~
    alt~text,~so~this~check~also~catches~figures~you~forgot~to~describe.
  }

\msg_new:nnnn { latexally } { alt-has-markup }
  { Alt~text~contains~LaTeX~markup:~'#1'. }
  {
    /Alt~is~a~plain~PDF~string,~expanded~once~and~hex-encoded.~A~screen~reader~
    announces~$\frac{1}{2}$~as~"dollar~backslash~f-r-a-c~one~two~dollar".~
    Write~plain~words:~"one~half".
  }

\msg_new:nnnn { latexally } { described-broken }
  { Described~region~is~taller~than~the~text~block. }
  {
    A~marked-content~sequence~cannot~cross~a~page~boundary,~so~a~Described~body~
    must~fit~on~one~page.~Split~the~region,~or~use~the~starred~form~
    \string\begin{Described*}~and~verify~the~resulting~tag~tree.
  }

\msg_new:nnnn { latexally } { no-bookmarks }
  { No~bookmark~mechanism~is~available;~this~PDF~will~have~no~outline. }
  {
    Tagging~never~writes~/Outlines,~so~bookmarks~need~hyperref~or~the~bookmark~
    package.~Neither~is~loaded,~so~every~heading~registered~by~this~package~has~
    been~silently~discarded.~WCAG~2.1~AA~expects~an~outline~for~multi-page~
    documents~(SC~2.4.5,~technique~PDF2).~Add~\string\usepackage{bookmark}~to~
    the~preamble.
  }

\msg_new:nnnn { latexally } { bookmarks-not-clickable }
  { Bookmarks~have~no~destinations~and~will~not~navigate. }
  {
    An~outline~entry~needs~an~ANCHOR~at~the~heading,~and~only~hyperref~provides~
    one~(\string\pdfbookmark).~With~the~bookmark~package~alone~the~entries~are~
    written~but~point~nowhere,~so~clicking~one~does~nothing.~Load~hyperref.
  }

\msg_new:nnnn { latexally } { heading-level }
  { Heading~level~#1~follows~level~#2,~skipping~a~level. }
  {
    Skipped~heading~levels~are~a~machine-testable~PDF/UA~failure~
    (Matterhorn~14-003)~and~break~outline~navigation.~Insert~the~missing~level~
    or~renumber.
  }

%% ---------------------------------------------------------------------------
%% 2. Alt-text validation
%% ---------------------------------------------------------------------------
%% Runs on every alt string before it can reach the PDF. This is the guard that
%% the previous generation of this tooling lacked.

\tl_new:N \l__access_alt_tl

\cs_new_protected:Npn \__access_validate_alt:nn #1#2
  {
    \tl_set:Nn \l__access_alt_tl {#1}
    \tl_if_blank:nTF {#1}
      { \msg_error:nnn { latexally } { alt-empty } {#2} }
      {
        \__access_alt_check_placeholder:n {#1}
        \__access_alt_check_filename:n    {#1}
        \__access_alt_check_markup:n      {#1}
      }
  }
\cs_generate_variant:Nn \__access_validate_alt:nn { Vn }

\clist_new:N \g__access_placeholder_clist
\clist_gset:Nn \g__access_placeholder_clist
  { <<ALT: , TODO , TO~DO , FIXME , XXX , ??? , DESCRIBE~ME , PLACEHOLDER }

\cs_new_protected:Npn \__access_alt_check_placeholder:n #1
  {
    \clist_map_inline:Nn \g__access_placeholder_clist
      {
        \tl_if_in:nnT {#1} {##1}
          { \msg_error:nnn { latexally } { alt-placeholder } {#1} }
      }
  }

\cs_new_protected:Npn \__access_alt_check_filename:n #1
  {
    \clist_map_inline:nn { .png , .jpg , .jpeg , .pdf , .eps , .svg , .PNG , .JPG }
      {
        \tl_if_in:nnT {#1} {##1}
          { \msg_warning:nnn { latexally } { alt-is-filename } {#1} }
      }
  }

\cs_new_protected:Npn \__access_alt_check_markup:n #1
  {
    \tl_if_in:nnT {#1} { $ }
      { \msg_warning:nnn { latexally } { alt-has-markup } {#1} }
    %% The needle must be an actual backslash character, so \c_backslash_str is
    %% e-expanded first; \str_if_in:nn would otherwise look for the literal
    %% eleven characters "\c_backslash_str".
    \exp_args:Nne \str_if_in:nnT {#1} { \c_backslash_str }
      { \msg_warning:nnn { latexally } { alt-has-markup } {#1} }
  }

%% ---------------------------------------------------------------------------
%% 3. Described -- the strict "speak only this" region
%% ---------------------------------------------------------------------------

\box_new:N \l__access_described_box

%% ---------------------------------------------------------------------------
%% The text layer
%% ---------------------------------------------------------------------------
%% /Alt reaches readers that walk the tag tree. /ActualText was supposed to
%% reach everything else -- and **[verified]** it does not: macOS PDFKit, which
%% is Preview, Quick Look and VoiceOver-in-Preview, ignores /ActualText during
%% extraction outright. Measured with a PDFKit extractor against a figure whose
%% /ActualText was correct: the string that came back was the drawing's own
%% glyphs. pdf.js behaves the same way.
%%
%% So on the viewer most students actually open, a perfectly described figure
%% still reads as its stray labels. The only channel those viewers do honour is
%% the text layer itself, so put the description there in PDF text rendering
%% mode 3 -- marks are made, no glyphs are painted. This is the same mechanism
%% every OCR layer uses.
%%
%% It sits INSIDE the Figure's marked content with tagging suspended, so it adds
%% nothing to the tag tree: a tag-following reader still hears /Alt exactly once
%% and never sees this. Zero width and height, so it cannot move the figure.
%%
%% ponytail: extraction order is positional, so on a tall figure the
%% description can sort after the drawing's own labels rather than before them.
%% Placing it first is what makes that the common case; guaranteeing it would
%% mean measuring the body, and the inline form has no box to measure.
%% On by default. The `text-layer' key's .initial:n below is what sets it, at
%% \keys_define time; do not also set it here, where it would be overridden.
\bool_new:N \g__access_textlayer_bool

\cs_new_protected:Npn \__access_text_layer:n #1
  {
    \bool_if:NT \g__access_textlayer_bool
      {
        %% \pdfliteral is a pdfTeX primitive; lualatex spells it \pdfextension
        %% literal and xelatex has \special{pdf:literal}. Guarded rather than
        %% assumed, because an undefined control sequence here would break every
        %% described figure on an engine this corpus does not use today.
        \cs_if_exist:NT \pdfliteral
          {
            %% \parbox, because the string is a sentence and a zero-width box
            %% does not wrap: set as one long line it runs past the page edge
            %% and everything beyond the trim is simply absent from the text
            %% layer -- the description arrives truncated mid-word.
            \makebox [ 0pt ] [ l ]
              {
                \smash
                  {
                    %% [b]: the reference point is the box's BOTTOM, so a
                    %% multi-line description grows upward into the figure's
                    %% own area instead of trailing off below it -- and off
                    %% the page, where it would be clipped away again.
                    \parbox [ b ] { \linewidth }
                      {
                        \pdfliteral { 3~Tr }
                        #1
                        \pdfliteral { 0~Tr }
                      }
                  }
              }
          }
      }
  }

%% Unstarred: body goes in an unbreakable box, so the marked-content leaf is
%% guaranteed well formed. Starred: body may break; one MC leaf per page ends up
%% under the same Figure element, which is legal but worth verifying.
%% ORDER IS LOAD-BEARING. The Figure element and the tagging suspension must be
%% opened INSIDE the box, before any body content is typeset. Capturing the body
%% into a box first and only then opening the Figure looks equivalent and is
%% not: the body is typeset during box construction, while tagging is still
%% live, so a TikZ node's text opens its own `text` marked-content sequence.
%% That sequence then sits nested inside the Figure and IS announced -- the
%% suppression silently fails while the /Alt still looks correct.
\NewDocumentEnvironment { Described } { s m }
  {
    \__access_validate_alt:nn {#2} { Described~region }
    \IfBooleanTF {#1}
      { \par \tagpdfparaOff \__access_described_open:n {#2} }
      {
        \par
        \tagpdfparaOff
        \vbox_set:Nw \l__access_described_box
        \__access_described_open:n {#2}
      }
  }
  {
    \IfBooleanTF {#1}
      { \__access_described_close: \tagpdfparaOn }
      {
        \__access_described_close:
        \vbox_set_end:
        \dim_compare:nNnT { \box_ht:N \l__access_described_box } > { \textheight }
          { \msg_warning:nn { latexally } { described-broken } }
        \box_use_drop:N \l__access_described_box
        \tagpdfparaOn
      }
  }

\cs_new_protected:Npn \__access_described_open:n #1
  {
    \leavevmode
    %% Paragraph tagging is toggled by the CALLER, not here, and it must bracket
    %% the whole region -- box construction AND placement. Toggling it inside
    %% means a body containing `center` (or anything else built on trivlist)
    %% opens its paragraph hook with tagging off and closes it with tagging on,
    %% and tagpdf aborts with "the number of automatic begin and end text para
    %% hooks differ".
    %% If we are inside running text an MC sequence is already open, and marked
    %% content cannot nest. Close it, stash it, and reopen it on the way out --
    %% the same push/pop pair tagpdf uses for its own artifact groups.
    \tag_mc_end_push:
    \tagstructbegin { tag=Figure , alt={#1} }
    %% /Alt on the structure element serves readers that walk the tag tree.
    %% /ActualText on the marked content serves everything else -- macOS
    %% Preview and every "read aloud" built on positional text extraction --
    %% and without it a described figure is announced by the labels drawn
    %% INSIDE it, which is precisely what this environment exists to suppress.
    %% Verified: a TikZ node reading "SECRETLABEL" was extracted verbatim from
    %% a figure whose /Alt was perfectly correct.
    %%
    %% Braced, because a description is a sentence and sentences have commas;
    %% an unbraced value ends the key at the first one and the remainder is
    %% parsed as a key of its own.
    \tagmcbegin { actualtext = {#1} }
    %% Everything from here to the matching resume is invisible to the tag
    %% tree: no structure elements, no paragraph counting, nothing for a
    %% screen reader to descend into. The /Alt above is all that remains.
    \SuspendTagging { latexally/Described }
    %% After the suspension, so it contributes no structure; inside the MC, so
    %% /ActualText still covers it for any reader that does honour that.
    \__access_text_layer:n {#1}
  }
\cs_generate_variant:Nn \__access_described_open:n { V }

\cs_new_protected:Npn \__access_described_close:
  {
    \ResumeTagging { latexally/Described }
    \tagmcend
    \tagstructend
    \tag_mc_begin_pop:n { }
  }

%% Inline command form, for wrapping a single graphic without a display block.
\NewDocumentCommand \described { m +m }
  {
    \__access_validate_alt:nn {#1} { \string\described }
    \mbox
      {
        \__access_described_open:n {#1}
        #2
        \__access_described_close:
      }
  }

%% ---------------------------------------------------------------------------
%% 4. Decorative -- speaks nothing at all
%% ---------------------------------------------------------------------------
%% PDF/UA exempts decorative content only via the artifact mechanism. An empty
%% /Alt on a Figure is a failure; an artifact is a conformant exemption.

%% tagpdf provides a dedicated helper for exactly this: it opens an artifact
%% marked-content sequence AND suspends tagging, so the region needs no
%% enclosing structure element. Opening a bare \tagmcbegin{artifact} in vertical
%% mode instead fails with "there is no open structure on the stack".
%% The argument is the PDF artifact SUBTYPE, not a free label. tagpdf accepts
%% only pagination[/header|/footer], layout, page, background and notype.
%% "Layout" is the spec's category for purely cosmetic design elements, which is
%% what a decorative rule or a course banner is.
%% ponytail: a Decorative region containing TEXT still leaks to readers that
%% extract by position -- they ignore the artifact mechanism entirely, and
%% tagpdf's artifact API emits `/Artifact BMC' with no property list, so there
%% is nowhere to hang the /ActualText that stops it (unlike Described above).
%% Unreachable in this corpus: `artifact_allowlist' holds three JPEGs and a
%% raster contributes no extractable text. ALLY-PDF-032 reports it if that ever
%% stops being true; the fix then is to describe the figure, not to mark it
%% decorative.
\cs_new_protected:Npn \__access_artifact_begin:
  {
    \cs_if_exist_use:NTF \tag_mc_artifact_group_begin:n
      { { layout } }
      { \tagmcbegin { artifact } \SuspendTagging { latexally/Decorative } }
  }
\cs_new_protected:Npn \__access_artifact_end:
  {
    \cs_if_exist_use:NTF \tag_mc_artifact_group_end:
      { }
      { \ResumeTagging { latexally/Decorative } \tagmcend }
  }

\NewDocumentEnvironment { Decorative } { }
  { \leavevmode \tagpdfparaOff \__access_artifact_begin: }
  { \__access_artifact_end: \tagpdfparaOn }

\NewDocumentCommand \decorative { +m }
  { \mbox { \begin{Decorative} #1 \end{Decorative} } }

%% ---------------------------------------------------------------------------
%% 5. DescribedFigure -- short /Alt plus a visible long description (tier T2)
%% ---------------------------------------------------------------------------
%% /Alt is atomic: a screen-reader user cannot pause inside it, re-read one
%% sentence, or navigate a list or table within it. So a figure needing more
%% than a sentence gets a SHORT /Alt plus a real, visible description in the
%% body -- which is also what W3C WAI recommends ("long descriptions benefit
%% many people and should be made available to everyone") and what NCAM
%% requires for chart data ("presented as tables, not as narrative").

\tl_new:N \l__access_figure_description_tl

%% The key is `description`, matching the environment name, not `alt`. `alt` is
%% the name of the PDF dictionary entry this ends up in; it is not the name of
%% the thing an author writes. Keeping the two distinct is what lets
%% \LongDescription sit next to it without implying a second /Alt.
\keys_define:nn { latexally / figure }
  {
    description .tl_set:N  = \l__access_figure_description_tl ,
    description .initial:n = { } ,
  }

%% Boxed like the unstarred Described, for the same reason: a figure body almost
%% always contains `center`, and an unboxed region leaves its paragraph hooks
%% straddling the tagging toggle.
\NewDocumentEnvironment { DescribedFigure } { O{} }
  {
    \group_begin:
    \keys_set:nn { latexally / figure } {#1}
    \__access_validate_alt:Vn \l__access_figure_description_tl { DescribedFigure }
    \par
    \tagpdfparaOff
    \vbox_set:Nw \l__access_described_box
    \__access_described_open:V \l__access_figure_description_tl
  }
  {
    \__access_described_close:
    \vbox_set_end:
    \box_use_drop:N \l__access_described_box
    \tagpdfparaOn
    \group_end:
  }

%% The long description is ordinary tagged prose placed immediately after the
%% figure, so it is the next thing in reading order -- no "see below" needed.
%% Deliberately NOT tagged as Caption: a Caption element must be a child of the
%% Figure or Table it belongs to, and this text sits after the figure at
%% document level, so `Caption` there is an invalid parent-child relation that
%% tagpdf reports and PDF/UA checkers flag. Plain prose is also the semantically
%% honest choice -- this is body text, visible to everyone, and the paragraph
%% module tags it as a P element on its own.
%% The visible label is an optional argument rather than the hardcoded "Figure
%% description" it used to be: this command is equally correct after a DataTable,
%% and announcing a table as a figure is a small lie told in every reading of the
%% document.
\NewDocumentCommand \LongDescription { O{Description} +m }
  {
    \par
    \begingroup
      \small
      \textbf { #1. }~#2
    \par
    \endgroup
  }

%% ---------------------------------------------------------------------------
%% 6. Tables
%% ---------------------------------------------------------------------------
%% Fail-safe default: every table is a LAYOUT table until an author opts in.
%% A layout grid announced as "table with 21 columns" traps a screen-reader user
%% in a structure that carries no meaning, which is worse than no tagging. The
%% DataTable wrapper opts a genuine data table in, and resets the (sticky)
%% latex-lab table keys on exit -- forgetting that reset is the single biggest
%% footgun in latex-lab-table.

%% `table/tagging` accepts true|on|false|off|presentation. There is no
%% `structure` value; `true` is the structural (real Table/TR/TH/TD) mode.
\NewDocumentEnvironment { DataTable } { O{} }
  {
    \tagpdfsetup { table/tagging=true , #1 }
  }
  {
    \tagpdfsetup
      { table/tagging=presentation , table/header-rows={} , table/header-columns={} }
  }

\NewDocumentEnvironment { LayoutTable } { }
  { \tagpdfsetup { table/tagging=presentation } }
  { }

%% ---------------------------------------------------------------------------
%% 7. Headings and bookmarks
%% ---------------------------------------------------------------------------
%% Tagging and bookmarks are different PDF object graphs: nothing in tagpdf ever
%% writes /Outlines. PDF/UA does not require an outline, but WCAG 2.1 AA does
%% for multi-page documents (SC 2.4.5, technique PDF2), so we emit both.
%%
%% Bookmark text is a PDF string, not typeset material, so math and font
%% switches must be stripped. \accessheading takes an optional plain-text form for
%% exactly that; latexally's Python side generates it automatically.

\int_new:N \g__access_last_level_int
\int_gzero:N \g__access_last_level_int
\int_new:N  \g__access_bookmark_int

\cs_new_protected:Npn \__access_check_level:n #1
  {
    \int_compare:nNnT {#1} > { \g__access_last_level_int + 1 }
      {
        \int_compare:nNnT { \g__access_last_level_int } > { 0 }
          { \msg_warning:nnee { latexally } { heading-level }
              { \int_to_arabic:n {#1} }
              { \int_to_arabic:n { \g__access_last_level_int } } }
      }
    \int_gset:Nn \g__access_last_level_int {#1}
  }

%% #1 optional plain-text form for the bookmark, #2 level (1-6), #3 heading text.
%% The optional argument cannot default to #3 (xparse defaults cannot reference
%% other arguments), so the fallback is applied explicitly.
\NewDocumentCommand \accessheading { o m +m }
  {
    \par
    \__access_check_level:n {#2}
    \int_gincr:N \g__access_bookmark_int
    \IfNoValueTF {#1}
      { \__access_bookmark:nn {#2} {#3} }
      { \__access_bookmark:nn {#2} {#1} }
    %% Paragraph tagging must be off across the heading. With it on, the para
    %% module opens its own text-unit/text structure inside our H element, which
    %% produces both an invalid Parent-Child relation (H1 -> text-unit) and a
    %% nested marked-content sequence -- tagpdf reports "nested marked content
    %% found" and the structure stack never recovers.
    \tagpdfparaOff
    \tagstructbegin { tag=H#2 }
    \tagmcbegin { tag=H#2 }
    #3
    \tagmcend
    \tagstructend
    \par
    \tagpdfparaOn
  }

%% Inline variant: no \par, so it can be used inside a list item or mid-line.
%% \qns expands inside an \item, where a heading that issued \par would split
%% the item and change the layout.
%% Paragraph tagging is switched off across the heading. Without that, the para
%% module opens its own text-unit inside our H element and tagpdf reports
%% `Parent-Child 'H2' --> 'text-unit'` -- and, worse, the heading ends up inside
%% a P, which PDF forbids outright (`Parent-Child 'P' --> 'H2'`). With para
%% tagging off the H attaches directly to whatever encloses it (an LBody, say),
%% which is the valid structure.
\NewDocumentCommand \accessheadinginline { o m +m }
  {
    \__access_check_level:n {#2}
    \int_gincr:N \g__access_bookmark_int
    \IfNoValueTF {#1}
      { \__access_bookmark:nn {#2} {#3} }
      { \__access_bookmark:nn {#2} {#1} }
    \tagpdfparaOff
    \tag_mc_end_push:
    \tagstructbegin { tag=H#2 }
    \tagmcbegin { tag=H#2 }
    #3
    \tagmcend
    \tagstructend
    \tag_mc_begin_pop:n { }
    \tagpdfparaOn
  }

%% Bookmark without a tag or visible text. Used where a navigable entry is
%% wanted but there is no text of our own to wrap -- a list-generated part
%% label, for instance -- and inventing visible text would change the page.
\NewDocumentCommand \accessbookmarkonly { m +m }
  {
    \int_gincr:N \g__access_bookmark_int
    \__access_bookmark:nn {#1} {#2}
  }

\cs_new:Npn \__access_plain:n #1 { \__access_pdfstring:n {#1} }

%% Fail loudly rather than silently: a document that tags perfectly and has no
%% outline looks fine in every check except the one a reader actually uses.
\AtBeginDocument
  {
    \cs_if_exist:NF \bookmark
      { \cs_if_exist:NF \pdfbookmark { \msg_warning:nn { latexally } { no-bookmarks } } }
  }

%% \pdfbookmark, NOT \bookmark[dest=...].
%%
%% The two look interchangeable and are not. `dest=` REFERENCES a destination;
%% it does not create one. Nothing else in this package created them, so the
%% bookmark package invented the missing anchors -- all of them at the start of
%% the document, as `/Fit` on page 1. Every check passed: 48 bookmarks, correct
%% titles, correct nesting, a populated /Names /Dests tree. And clicking any
%% entry jumped to page 1, which is indistinguishable from "the outline does not
%% work".
%%
%% hyperref's \pdfbookmark writes the outline entry AND drops the anchor at the
%% current point, in one call. Its \hyper@anchorstart brackets the anchor with
%% \Hy@SaveLastskip / \Hy@RestoreLastskip precisely so the whatsit cannot change
%% spacing -- verified here as 0.00% pixel difference against the previous build.
\cs_new_protected:Npn \__access_bookmark:nn #1#2
  {
    \cs_if_exist:NTF \pdfbookmark
      {
        \pdfbookmark [#1] { \__access_pdfstring:n {#2} }
          { ally.bm.\int_use:N \g__access_bookmark_int }
      }
      {
        %% No hyperref: the bookmark package alone can still write an outline,
        %% but it has no anchor mechanism, so the entries carry no destination
        %% and cannot navigate. An outline that lists the document without
        %% moving to it is worth having; saying so is what stops it looking
        %% like a bug in this package.
        \cs_if_exist:NT \bookmark
          {
            \bookmark [ level=#1 ] { \__access_pdfstring:n {#2} }
            \msg_warning:nn { latexally } { bookmarks-not-clickable }
          }
      }
  }

%% Convert typeset material to a PDF string.
%%
%% A bookmark title is a PDF string, not typeset material: font switches, colour
%% commands and counters do not "render" there. Passing heading text through
%% unchanged produces outlines like "allySolutionSolution" (the \color argument
%% arriving as literal text) and "Question " (a counter that never expanded).
%%
%% l3text's \text_purify:n exists for exactly this: it expands what should
%% expand and discards formatting. Commands it does not know are declared below.
\cs_if_exist:NTF \text_purify:n
  { \cs_new:Npn \__access_pdfstring:n #1 { \text_purify:n {#1} } }
  { \cs_new:Npn \__access_pdfstring:n #1 { #1 } }

\cs_if_exist:NT \text_declare_purify_equivalent:Nn
  {
    \text_declare_purify_equivalent:Nn \color        { }
    \text_declare_purify_equivalent:Nn \colorlet     { }
    \text_declare_purify_equivalent:Nn \textcolor    { \use_ii:nn }
    \text_declare_purify_equivalent:Nn \bfseries     { }
    \text_declare_purify_equivalent:Nn \normalfont   { }
    \text_declare_purify_equivalent:Nn \normalsize   { }
    \text_declare_purify_equivalent:Nn \large        { }
    \text_declare_purify_equivalent:Nn \Large        { }
    \text_declare_purify_equivalent:Nn \LARGE        { }
    \text_declare_purify_equivalent:Nn \small        { }
  }

%% ---------------------------------------------------------------------------
%% 8. Metadata and language
%% ---------------------------------------------------------------------------

\NewDocumentCommand \accesstitle { m }
  {
    \tl_gset:Nn \g__access_title_tl {#1}
    \cs_if_exist:NT \hypersetup { \hypersetup { pdftitle={#1} } }
    \cs_if_exist:NT \AddToDocumentProperties
      { \AddToDocumentProperties [document] { title } {#1} }
  }
\tl_new:N \g__access_title_tl

%% ---------------------------------------------------------------------------
%% 9. Colour
%% ---------------------------------------------------------------------------
%% Contrast is enforced at the SOURCE level by the Python linter, which can
%% compute WCAG relative luminance from \definecolor. This package only provides
%% conforming defaults; it deliberately does not silently recolour a document.

%% These are the blind fallbacks, for a document whose palette the run does not
%% know. They are the SMALLEST darkening of the course's own colours that clears
%% 4.5:1, not the darkest thing that clears it: #0645AD passed at 8.53:1 and was
%% reported as much harder to read than the blue it replaced, which is the whole
%% argument for landing on the floor rather than well past it.
\definecolor { allySolution } { HTML } { 187AC4 } % 4.55:1 on white; was #3399E6 at 3.07:1
\definecolor { allyAnswer }   { HTML } { 187AC4 }
\definecolor { allyWarning }  { HTML } { EE0000 } % 4.53:1; plain red is 4.00:1
\definecolor { allyAccent }   { HTML } { 6A1B9A } % 9.39:1

%% The guard is \string\color@<name>, NOT color@<name>. xcolor stores a colour
%% under a control sequence whose name STARTS WITH A LITERAL BACKSLASH -- it
%% builds the csname with \string\color@#1 -- so \@ifundefined{color@foo} is
%% true for every colour that has ever been defined. This was written the wrong
%% way and made the whole command a silent no-op: every "conforming palette"
%% build left the failing colours exactly as the course defined them, while the
%% run reported a conforming palette. Verified: a document defining
%% solutionColor as rgb(0.2,0.6,0.9) still filled 0.2 0.6 0.9 in the PDF.
\NewDocumentCommand \accessconformingcolors { }
  {
    \__access_recolor:nn { solutionColor } { allySolution }
    \__access_recolor:nn { solansColor }   { allySolution }
    \__access_recolor:nn { answerColor }   { allyAnswer }
    \__access_recolor:nn { blueish }       { allyAccent }
    \__access_recolor:nn { redish }        { allyWarning }
  }

%% Recolour #1 to #2, but only if the document actually defines #1. Conjuring a
%% colour the document never had would be inventing style, not fixing it.
\cs_new_protected:Npn \__access_recolor:nn #1#2
  { \@ifundefined { \string \color@#1 } { } { \colorlet {#1} {#2} } }

%% One colour, by name, to an exact value the run computed -- the smallest
%% darkening of what the course itself defines that clears the contrast floor.
%% The runner emits one of these per colour it changes.
%%
%% Deferred to begindocument for the same reason \accessconformingcolors is: the
%% document defines its own colours AFTER the preamble lines we inject, so an
%% immediate \definecolor here would simply be overwritten by the course's own.
%% Guarded like the colorlets above, so a name this document never defines is
%% left alone rather than conjured into existence.
\NewDocumentCommand \accessrecolor { m m }
  {
    \AddToHook { begindocument }
      { \@ifundefined { \string \color@#1 } { } { \definecolor {#1} { HTML } {#2} } }
  }

%% ---------------------------------------------------------------------------
%% 10. Package options
%% ---------------------------------------------------------------------------

\keys_define:nn { latexally }
  {
    strict            .bool_gset:N = \g__access_strict_bool ,
    strict            .initial:n   = true ,
    conforming-colors .code:n      = { \AtBeginDocument { \accessconformingcolors } } ,
    %% Off suppresses the invisible description text. The figure then reads
    %% correctly only in a tag-following reader; Preview and pdf.js fall back to
    %% the drawing's own glyphs. See \__access_text_layer:n.
    text-layer        .bool_gset:N = \g__access_textlayer_bool ,
    text-layer        .initial:n   = true ,
  }

\NewDocumentCommand \accesssetup { m } { \keys_set:nn { latexally } {#1} }

%% In non-strict mode an unfilled placeholder degrades to a warning. This exists
%% for mid-migration builds only; never ship a document built this way.
\AtBeginDocument
  {
    \bool_if:NF \g__access_strict_bool
      {
        \msg_redirect_name:nnn { latexally } { alt-placeholder } { warning }
        \msg_redirect_name:nnn { latexally } { alt-empty }       { warning }
      }
  }

%% ---------------------------------------------------------------------- %%
%% ulem: keep the underline, lose the garbage
%% ---------------------------------------------------------------------- %%
%%
%% `\DocumentMetadata' alone -- no tagging, no testphase -- makes a document
%% that loads `ulem' typeset ulem's own internals into the page:
%%
%%     Text is 1000cmd/emph/after0emphasised here, done.
%%
%% Six lines reproduce it: \DocumentMetadata, \documentclass, \usepackage{ulem},
%% one \emph. Six LaTeX errors, the first "Missing \endcsname inserted" with
%% "<to be read again> \xdef", and that text on the page. **[verified]** on
%% three pages of two real sp26/hw/7 PDFs before it was found -- and NOT found
%% by the checks, which read the structure tree and the /Alt coverage and never
%% looked at what the page actually said.
%%
%% Mechanism: ulem's \ULforem redefines \emph as a ZERO-argument macro
%% expanding to \uline, relying on \uline to grab the following group itself.
%% `\DocumentMetadata' switches on LaTeX's generic command hooks, which wrap
%% \emph's replacement text -- putting \UseHookWithArguments{cmd/emph/after}{0}
%% between \uline and its argument. \uline underlines the hook call,
%% \UseHookWithArguments builds a \csname, and expansion runs into the
%% \xdef\UL@spfactor in ulem.sty. \uline{x} written directly is fine; it is the
%% hook wrapper around a zero-argument \emph that breaks.
%%
%% So give \emph the argument the hook mechanism expects it to have. Measured
%% against the untagged original at 110 dpi:
%%
%%     \normalem alone (\emph back to italic)   0.0764% of pixels
%%     this, keeping the underline              0.0000%
%%
%% Underlining for emphasis is poor practice -- underline conventionally means
%% a link -- but that is the course's call, not something to change by way of a
%% bug fix. This keeps the page byte-identical.
%%
%% `package/ulem/after' rather than \@ifpackageloaded: the hook fires whenever
%% ulem loads, so a driver that loads it after this package is covered too.
\AddToHook{package/ulem/after}
  {
    \normalem
    \renewcommand{\emph}[1]{\uline{#1}}
  }

%% ---------------------------------------------------------------------- %%
%% Enumerate labels that survive tagging
%% ---------------------------------------------------------------------- %%
%%
%% enumitem's `label=\roman*' resolves its counter when the list is set. Under
%% `testphase={tagpdf}' that resolution happens against a counter that has not
%% been stepped, so every item reads (i) -- and with a non-starred counter it is
%% wrong with nothing in the log to say so.
%%
%% The usual answer, `\renewcommand{\labelenumi}{...}', names a depth. That is
%% wrong for most of this corpus: 483 of 667 label options are at least two
%% enumerates deep inside their own file, and every question file is \input
%% inside the driver's own \begin{enumerate}[series=qn], so even a top-level
%% list in a question is enumii or deeper by the time it is set. The depth
%% cannot be read off the source at all.
%%
%% So LaTeX is asked for it instead. `latexally rewrite' turns
%%
%%     \begin{enumerate}[label=(\roman*)]
%% into
%%     \AllyEnumLabel{(\roman{\allyenum})}%
%%     \begin{enumerate}
%%
%% \@enumdepth is LaTeX2e's own counter of how many enumerates are open, so
%% these are plain LaTeX2e rather than expl3: `@' is already a letter here.

%% The counter name of the list being typeset RIGHT NOW: enumi, enumii, ...
%% Expandable, because it is used inside \roman{...}, which expands its
%% argument through \csname c@...\endcsname.
\newcommand\allyenum{enum\romannumeral\@enumdepth}

%% Set the label of the enumerate that is ABOUT to open. \begin{enumerate}
%% freezes its label into \@itemlabel as it starts, so this has to run first --
%% hence \@enumdepth+1, the depth the list will have once it is open.
\newcommand\AllyEnumLabel[1]{%
  \expandafter\renewcommand
  \csname labelenum\romannumeral\numexpr\@enumdepth+1\relax\endcsname{#1}}

\endinput
