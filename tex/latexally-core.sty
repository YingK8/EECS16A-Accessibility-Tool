%% latexally-core.sty
%% Part of latexally — https://github.com/YingK8/EECS16A-Accessibility-Tool
%% SPDX-License-Identifier: MIT
%% Accessibility primitives for tagged PDF output: strict alt text, tagged
%% headings with bookmarks, accessible tables, and a WCAG-conforming palette.

\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesExplPackage{latexally-core}{2026-08-08}{0.1.0}
  {Strict alt text, tagged headings and accessible tables}

\RequirePackage{xcolor}

\AddToHook{begindocument/before}{\RequirePackage{bookmark}}

%% 0. Graceful degradation

\providecommand \tagstructbegin [1] {}
\providecommand \tagstructend       {}
\providecommand \tagmcbegin    [1] {}
\providecommand \tagmcend           {}
\providecommand \tagpdfsetup   [1] {}
\providecommand \SuspendTagging[1] {}
\providecommand \ResumeTagging [1] {}

\bool_new:N \l__access_tagging_bool
\bool_new:N \g__access_strict_bool
\bool_gset_true:N \g__access_strict_bool

\cs_new_protected:Npn \__access_if_tagging:TF #1#2
  {
    \cs_if_exist:NTF \tag_if_active:TF
      { \tag_if_active:TF {#1} {#2} }
      {#2}
  }

%% 1. Messages

\msg_new:nnnn { latexally } { alt-empty }
  { Empty~alt~text~for~a~#1. }
  {
    A~Figure~structure~element~with~an~empty~/Alt~is~a~PDF/UA-1~failure~
    (Matterhorn~13-004),~not~an~exemption.~If~this~graphic~is~decorative,~use~
    the~Decorative~environment~instead,~which~marks~it~as~an~artifact.
  }

\msg_new:nnnn { latexally } { alt-placeholder }
  { Unfilled~alt-text~placeholder:~'#1'. }
  {
    A~placeholder~would~ship~into~the~PDF~as~real~/Alt~text.~A~screen~reader~
    would~announce~it~verbatim,~and~-- worse -- the~document~would~PASS~a~naive~
    "every~Figure~has~/Alt"~check~and~veraPDF,~producing~a~silent~false~
    conformance~claim.~Fill~in~the~description~before~building.
  }

\msg_new:nnnn { latexally } { alt-is-filename }
  { Alt~text~looks~like~a~file~name:~'#1'. }
  {
    Announcing~"vehicle~setup~dot~pdf"~tells~a~student~nothing.~Describe~what~
    the~graphic~shows.~Note~that~latex-lab~uses~the~file~name~as~its~DEFAULT~
    alt~text,~so~this~check~also~catches~figures~you~forgot~to~describe.
  }

\msg_new:nnnn { latexally } { alt-has-markup }
  { Alt~text~contains~LaTeX~markup:~'#1'. }
  {
    /Alt~is~a~plain~PDF~string,~expanded~once~and~hex-encoded.~A~screen~reader~
    announces~$\frac{1}{2}$~as~"dollar~backslash~f-r-a-c~one~two~dollar".~
    Write~plain~words:~"one~half".
  }

\msg_new:nnnn { latexally } { described-broken }
  { Described~region~is~taller~than~the~text~block. }
  {
    A~marked-content~sequence~cannot~cross~a~page~boundary,~so~a~Described~body~
    must~fit~on~one~page.~Split~the~region,~or~use~the~starred~form~
    \string\begin{Described*}~and~verify~the~resulting~tag~tree.
  }

\msg_new:nnnn { latexally } { no-bookmarks }
  { No~bookmark~mechanism~is~available;~this~PDF~will~have~no~outline. }
  {
    Tagging~never~writes~/Outlines,~so~bookmarks~need~hyperref~or~the~bookmark~
    package.~Neither~is~loaded,~so~every~heading~registered~by~this~package~has~
    been~silently~discarded.~WCAG~2.1~AA~expects~an~outline~for~multi-page~
    documents~(SC~2.4.5,~technique~PDF2).~Add~\string\usepackage{bookmark}~to~
    the~preamble.
  }

\msg_new:nnnn { latexally } { bookmarks-not-clickable }
  { Bookmarks~have~no~destinations~and~will~not~navigate. }
  {
    An~outline~entry~needs~an~ANCHOR~at~the~heading,~and~only~hyperref~provides~
    one~(\string\pdfbookmark).~With~the~bookmark~package~alone~the~entries~are~
    written~but~point~nowhere,~so~clicking~one~does~nothing.~Load~hyperref.
  }

\msg_new:nnnn { latexally } { heading-level }
  { Heading~level~#1~follows~level~#2,~skipping~a~level. }
  {
    Skipped~heading~levels~are~a~machine-testable~PDF/UA~failure~
    (Matterhorn~14-003)~and~break~outline~navigation.~Insert~the~missing~level~
    or~renumber.
  }

%% 2. Alt-text validation

\tl_new:N \l__access_alt_tl

\cs_new_protected:Npn \__access_validate_alt:nn #1#2
  {
    \tl_set:Nn \l__access_alt_tl {#1}
    \tl_if_blank:nTF {#1}
      { \msg_error:nnn { latexally } { alt-empty } {#2} }
      {
        \__access_alt_check_placeholder:n {#1}
        \__access_alt_check_filename:n    {#1}
        \__access_alt_check_markup:n      {#1}
      }
  }
\cs_generate_variant:Nn \__access_validate_alt:nn { Vn }

\clist_new:N \g__access_placeholder_clist
\clist_gset:Nn \g__access_placeholder_clist
  { <<ALT: , TODO , TO~DO , FIXME , XXX , ??? , DESCRIBE~ME , PLACEHOLDER }

\cs_new_protected:Npn \__access_alt_check_placeholder:n #1
  {
    \clist_map_inline:Nn \g__access_placeholder_clist
      {
        \tl_if_in:nnT {#1} {##1}
          { \msg_error:nnn { latexally } { alt-placeholder } {#1} }
      }
  }

\cs_new_protected:Npn \__access_alt_check_filename:n #1
  {
    \clist_map_inline:nn { .png , .jpg , .jpeg , .pdf , .eps , .svg , .PNG , .JPG }
      {
        \tl_if_in:nnT {#1} {##1}
          { \msg_warning:nnn { latexally } { alt-is-filename } {#1} }
      }
  }

\cs_new_protected:Npn \__access_alt_check_markup:n #1
  {
    \tl_if_in:nnT {#1} { $ }
      { \msg_warning:nnn { latexally } { alt-has-markup } {#1} }
    \exp_args:Nne \str_if_in:nnT {#1} { \c_backslash_str }
      { \msg_warning:nnn { latexally } { alt-has-markup } {#1} }
  }

%% 3. Described -- the strict "speak only this" region

\box_new:N \l__access_described_box

%% The text layer
\bool_new:N \g__access_textlayer_bool

\cs_new_protected:Npn \__access_text_layer:n #1
  {
    \bool_if:NT \g__access_textlayer_bool
      {
        \cs_if_exist:NT \pdfliteral
          {
            \makebox [ 0pt ] [ l ]
              {
                \smash
                  {
                    \parbox [ b ] { \linewidth }
                      {
                        \pdfliteral { 3~Tr }
                        #1
                        \pdfliteral { 0~Tr }
                      }
                  }
              }
          }
      }
  }

\NewDocumentEnvironment { Described } { s m }
  {
    \__access_validate_alt:nn {#2} { Described~region }
    \IfBooleanTF {#1}
      { \par \tagpdfparaOff \__access_described_open:n {#2} }
      {
        \par
        \tagpdfparaOff
        \vbox_set:Nw \l__access_described_box
        \__access_described_open:n {#2}
      }
  }
  {
    \IfBooleanTF {#1}
      { \__access_described_close: \tagpdfparaOn }
      {
        \__access_described_close:
        \vbox_set_end:
        \dim_compare:nNnT { \box_ht:N \l__access_described_box } > { \textheight }
          { \msg_warning:nn { latexally } { described-broken } }
        \box_use_drop:N \l__access_described_box
        \tagpdfparaOn
      }
  }

\cs_new_protected:Npn \__access_described_open:n #1
  {
    \leavevmode
    \tag_mc_end_push:
    \tagstructbegin { tag=Figure , alt={#1} }
    \tagmcbegin { actualtext = {#1} }
    \SuspendTagging { latexally/Described }
    \__access_text_layer:n {#1}
  }
\cs_generate_variant:Nn \__access_described_open:n { V }

\cs_new_protected:Npn \__access_described_close:
  {
    \ResumeTagging { latexally/Described }
    \tagmcend
    \tagstructend
    \tag_mc_begin_pop:n { }
  }

\cs_new_protected:Npn \__access_hover:nn #1#2
  {
    \bool_lazy_and:nnTF
      { \g__access_hover_bool }
      { \cs_if_exist_p:N \pdftooltip }
      { \pdftooltip {#2} {#1} }
      {#2}
  }

\NewDocumentCommand \described { m +m }
  {
    \__access_validate_alt:nn {#1} { \string\described }
    \__access_hover:nn {#1}
      {
        \mbox
          {
            \__access_described_open:n {#1}
            #2
            \__access_described_close:
          }
      }
  }

%% 4. Decorative -- speaks nothing at all

\cs_new_protected:Npn \__access_artifact_begin:
  {
    \cs_if_exist_use:NTF \tag_mc_artifact_group_begin:n
      { { layout } }
      { \tagmcbegin { artifact } \SuspendTagging { latexally/Decorative } }
  }
\cs_new_protected:Npn \__access_artifact_end:
  {
    \cs_if_exist_use:NTF \tag_mc_artifact_group_end:
      { }
      { \ResumeTagging { latexally/Decorative } \tagmcend }
  }

\NewDocumentEnvironment { Decorative } { }
  { \leavevmode \tagpdfparaOff \__access_artifact_begin: }
  { \__access_artifact_end: \tagpdfparaOn }

\NewDocumentCommand \decorative { +m }
  { \mbox { \begin{Decorative} #1 \end{Decorative} } }

\NewDocumentEnvironment { DecorativeBlock } { }
  { \tagpdfparaOff \__access_artifact_begin: }
  { \__access_artifact_end: \tagpdfparaOn }

%% 5. DescribedFigure -- short /Alt plus a visible long description (tier T2)

\tl_new:N \l__access_figure_description_tl

\keys_define:nn { latexally / figure }
  {
    description .tl_set:N  = \l__access_figure_description_tl ,
    description .initial:n = { } ,
  }

\NewDocumentEnvironment { DescribedFigure } { O{} }
  {
    \group_begin:
    \keys_set:nn { latexally / figure } {#1}
    \__access_validate_alt:Vn \l__access_figure_description_tl { DescribedFigure }
    \par
    \tagpdfparaOff
    \vbox_set:Nw \l__access_described_box
    \__access_described_open:V \l__access_figure_description_tl
  }
  {
    \__access_described_close:
    \vbox_set_end:
    \box_use_drop:N \l__access_described_box
    \tagpdfparaOn
    \group_end:
  }

\NewDocumentCommand \LongDescription { O{Description} +m }
  {
    \par
    \begingroup
      \small
      \textbf { #1. }~#2
    \par
    \endgroup
  }

%% 6. Tables

\NewDocumentEnvironment { DataTable } { O{} }
  {
    \tagpdfsetup { table/tagging=true , #1 }
  }
  {
    \tagpdfsetup
      { table/tagging=presentation , table/header-rows={} , table/header-columns={} }
  }

\NewDocumentEnvironment { LayoutTable } { }
  { \tagpdfsetup { table/tagging=presentation } }
  { }

%% 7. Headings and bookmarks

\int_new:N \g__access_last_level_int
\int_gzero:N \g__access_last_level_int
\int_new:N  \g__access_bookmark_int

\cs_new_protected:Npn \__access_check_level:n #1
  {
    \int_compare:nNnT {#1} > { \g__access_last_level_int + 1 }
      {
        \int_compare:nNnT { \g__access_last_level_int } > { 0 }
          { \msg_warning:nnee { latexally } { heading-level }
              { \int_to_arabic:n {#1} }
              { \int_to_arabic:n { \g__access_last_level_int } } }
      }
    \int_gset:Nn \g__access_last_level_int {#1}
  }

\NewDocumentCommand \accessheading { o m +m }
  {
    \par
    \__access_check_level:n {#2}
    \int_gincr:N \g__access_bookmark_int
    \IfNoValueTF {#1}
      { \__access_bookmark:nn {#2} {#3} }
      { \__access_bookmark:nn {#2} {#1} }
    \tagpdfparaOff
    \tagstructbegin { tag=H#2 }
    \tagmcbegin { tag=H#2 }
    #3
    \tagmcend
    \tagstructend
    \par
    \tagpdfparaOn
  }

\NewDocumentCommand \accessheadinginline { o m +m }
  {
    \__access_check_level:n {#2}
    \int_gincr:N \g__access_bookmark_int
    \IfNoValueTF {#1}
      { \__access_bookmark:nn {#2} {#3} }
      { \__access_bookmark:nn {#2} {#1} }
    \tagpdfparaOff
    \tag_mc_end_push:
    \tagstructbegin { tag=H#2 }
    \tagmcbegin { tag=H#2 }
    #3
    \tagmcend
    \tagstructend
    \tag_mc_begin_pop:n { }
    \tagpdfparaOn
  }

\NewDocumentCommand \accessbookmarkonly { m +m }
  {
    \int_gincr:N \g__access_bookmark_int
    \__access_bookmark:nn {#1} {#2}
  }

\cs_new:Npn \__access_plain:n #1 { \__access_pdfstring:n {#1} }

\AtBeginDocument
  {
    \cs_if_exist:NF \bookmark
      { \cs_if_exist:NF \pdfbookmark { \msg_warning:nn { latexally } { no-bookmarks } } }
  }

\cs_new_protected:Npn \__access_bookmark:nn #1#2
  {
    \cs_if_exist:NTF \pdfbookmark
      {
        \pdfbookmark [#1] { \__access_pdfstring:n {#2} }
          { ally.bm.\int_use:N \g__access_bookmark_int }
      }
      {
        \cs_if_exist:NT \bookmark
          {
            \bookmark [ level=#1 ] { \__access_pdfstring:n {#2} }
            \msg_warning:nn { latexally } { bookmarks-not-clickable }
          }
      }
  }

\cs_if_exist:NTF \text_purify:n
  { \cs_new:Npn \__access_pdfstring:n #1 { \text_purify:n {#1} } }
  { \cs_new:Npn \__access_pdfstring:n #1 { #1 } }

\cs_if_exist:NT \text_declare_purify_equivalent:Nn
  {
    \text_declare_purify_equivalent:Nn \color        { }
    \text_declare_purify_equivalent:Nn \colorlet     { }
    \text_declare_purify_equivalent:Nn \textcolor    { \use_ii:nn }
    \text_declare_purify_equivalent:Nn \bfseries     { }
    \text_declare_purify_equivalent:Nn \normalfont   { }
    \text_declare_purify_equivalent:Nn \normalsize   { }
    \text_declare_purify_equivalent:Nn \large        { }
    \text_declare_purify_equivalent:Nn \Large        { }
    \text_declare_purify_equivalent:Nn \LARGE        { }
    \text_declare_purify_equivalent:Nn \small        { }
  }

%% 8. Metadata and language

\NewDocumentCommand \accesstitle { m }
  {
    \tl_gset:Nn \g__access_title_tl {#1}
    \cs_if_exist:NT \hypersetup { \hypersetup { pdftitle={#1} } }
    \cs_if_exist:NT \AddToDocumentProperties
      { \AddToDocumentProperties [document] { title } {#1} }
  }
\tl_new:N \g__access_title_tl

%% 9. Colour

\definecolor { allyBlue }   { HTML } { 0000FF } % 8.59:1  hue 240, pure
\definecolor { allyRed }    { HTML } { CC0000 } % 5.89:1  hue 0
\definecolor { allyGreen }  { HTML } { 006600 } % 7.24:1  hue 120
\definecolor { allyPurple } { HTML } { 6A0DAD } % 9.24:1  hue 275
\definecolor { allyOrange } { HTML } { B35A00 } % 4.80:1  hue 30

\colorlet { allySolution } { allyBlue }
\colorlet { allyAnswer }   { allyBlue }
\colorlet { allyWarning }  { allyRed }
\colorlet { allyAccent }   { allyPurple }

\NewDocumentCommand \accessconformingcolors { }
  {
    \__access_recolor:nn { solutionColor } { allySolution }
    \__access_recolor:nn { solansColor }   { allySolution }
    \__access_recolor:nn { answerColor }   { allyAnswer }
    \__access_recolor:nn { blueish }       { allyAccent }
    \__access_recolor:nn { redish }        { allyWarning }
  }

\cs_new_protected:Npn \__access_recolor:nn #1#2
  { \@ifundefined { \string \color@#1 } { } { \colorlet {#1} {#2} } }

\NewDocumentCommand \accesspalette { }
  {
    \__access_recolor:nn { solutionColor } { allyBlue }
    \__access_recolor:nn { solansColor }   { allyBlue }
    \__access_recolor:nn { answerColor }   { allyBlue }
    \__access_recolor:nn { blueish }       { allyPurple }
    \__access_recolor:nn { redish }        { allyRed }
    \colorlet { blue }   { allyBlue }
    \colorlet { red }    { allyRed }
    \colorlet { green }  { allyGreen }
    \colorlet { purple } { allyPurple }
    \colorlet { orange } { allyOrange }
    \accessinkhooks
  }

%% 9b. Drawing colours

%% Text and drawings do not sit next to the same thing. Body text sits on the
%% page, so the palette above is tuned to 4.5:1 against white. A plotted line
%% sits beside BLACK axes, and WCAG 1.4.11 asks 3:1 of it against every adjacent
%% colour -- the page AND that ink. A colour tuned only to the page fails the
%% other side: allyGreen is 7.24:1 on white but 2.90:1 on black, and a document
%% that darkens it again -- `green!70!black', which questionBank/sec/1 really
%% draws with -- lands at 1.90:1, indistinguishable from the axes.
%%
%% Same hues, moved in OKLCH lightness to the point that maximises the WORST of
%% three measurements: against the page, against black ink, and against black
%% ink after a `!70!black' mix. Each clears 3:1 on all three. Derived with
%% coloraide; tests/test_contrast.py re-derives them and fails on a hand edit.
\definecolor { allyInkBlue }    { HTML } { 4E84FF } % 3.47 page / 6.06 ink / 3.35 mixed
\definecolor { allyInkRed }     { HTML } { FF4233 } % 3.45 / 6.08 / 3.32
\definecolor { allyInkGreen }   { HTML } { 00A300 } % 3.36 / 6.24 / 3.41
\definecolor { allyInkOrange }  { HTML } { DA6C00 } % 3.42 / 6.14 / 3.38
\definecolor { allyInkPurple }  { HTML } { F54C6A } % 3.44 / 6.10 / 3.35
\definecolor { allyInkMagenta } { HTML } { F500F5 } % 3.40 / 6.18 / 3.33
\definecolor { allyInkTeal }    { HTML } { 339B9A } % 3.35 / 6.26 / 3.44

%% Three names are deliberately NOT bound, because a legible version of them is
%% not the same colour any more:
%%
%%   yellow  its legible form is #8F8F00, whose nearest CSS name is `olive'.
%%           Yellow needs its lightness to be yellow; darkening it to clear the
%%           page turns it green-brown, so it is left alone and reported.
%%   cyan    its legible form is 1.9 dE2000 from teal's -- one colour, two
%%           names -- and teal is the word this corpus draws with.
%%   gray    achromatic and used for grid lines, where being faint is the point.
\NewDocumentCommand \accessinkpalette { }
  {
    \colorlet { blue }    { allyInkBlue }
    \colorlet { red }     { allyInkRed }
    \colorlet { green }   { allyInkGreen }
    \colorlet { orange }  { allyInkOrange }
    \colorlet { purple }  { allyInkPurple }
    \colorlet { magenta } { allyInkMagenta }
    \colorlet { teal }    { allyInkTeal }
  }

%% `begin', not `before': the hook then runs inside the environment's group, so
%% the drawing palette lasts exactly as long as the drawing and the prose around
%% it keeps the text palette. circuitikz and pgfpicture are listed because a
%% document can open either without a tikzpicture around it; a pgfplots `axis'
%% always sits inside one.
\NewDocumentCommand \accessinkhooks { }
  {
    \AddToHook { env/tikzpicture/begin } { \accessinkpalette }
    \AddToHook { env/circuitikz/begin }  { \accessinkpalette }
    \AddToHook { env/pgfpicture/begin }  { \accessinkpalette }
  }

\NewDocumentCommand \accessrecolor { m m }
  {
    \AddToHook { begindocument }
      { \@ifundefined { \string \color@#1 } { } { \definecolor {#1} { HTML } {#2} } }
  }

%% 10. Package options

\keys_define:nn { latexally }
  {
    strict            .bool_gset:N = \g__access_strict_bool ,
    strict            .initial:n   = true ,
    conforming-colors .code:n      = { \AtBeginDocument { \accessconformingcolors } } ,
    palette           .code:n      = { \AtBeginDocument { \accesspalette } } ,
    text-layer        .bool_gset:N = \g__access_textlayer_bool ,
    text-layer        .initial:n   = true ,
    hover             .bool_gset:N = \g__access_hover_bool ,
    hover             .initial:n   = false ,
  }

\NewDocumentCommand \accesssetup { m } { \keys_set:nn { latexally } {#1} }

\AtBeginDocument
  {
    \bool_if:NF \g__access_strict_bool
      {
        \msg_redirect_name:nnn { latexally } { alt-placeholder } { warning }
        \msg_redirect_name:nnn { latexally } { alt-empty }       { warning }
      }
  }

\AddToHook{package/ulem/after}
  {
    \normalem
    \renewcommand{\emph}[1]{\uline{#1}}
  }

