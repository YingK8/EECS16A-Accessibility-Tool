%% latexally-ee16.sty
%% Accessibility retrofit for the existing EECS 16A macro set.
%% Patches the course's real ee16.sty instead of reimplementing it, so the page
%% is unchanged and only the tagging is added.

\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesExplPackage{latexally-ee16}{2026-08-08}{0.1.0}
  {Accessibility retrofit for the EECS 16A macro set}

\RequirePackage{latexally-core}

%% 0. Interword-space injection -- OFF, for visual fidelity
\AddToHook { begindocument }
  { \tagpdfsetup { activate/spaces = false } }

%% 1. Unicode-mapped text
\ifdefined\pdfgentounicode
  \pdfgentounicode=1
  \ExplSyntaxOff
  \InputIfFileExists{glyphtounicode.tex}{}{\input{glyphtounicode}}
  \ExplSyntaxOn
\fi

%% 2. Heading hooks

\bool_new:N \g__access_ee_patched_bool

%% 3. Title -> H1

\NewDocumentCommand \accessrecordtitle { }
  { \exp_args:Ne \accesstitle { \title } }

\ExplSyntaxOff
\AtBeginDocument{%
  \@ifundefined{@maketitle}{}{%
    \gdef\@maketitle{\newpage
      \accessrecordtitle
      \accessbookmarkonly{1}{\title}%
      \tagpdfparaOff
      \begin{DecorativeBlock}\hrule height6pt\end{DecorativeBlock} \vskip .7em
      \tagstructbegin{tag=P}\tagmcbegin{tag=P}%
      \makebox[0pt][l]{\makebox[1.3in][l]{\dunhb \coursenumber}}%
      \centerline{\dunhb \class}%
      \tagmcend\tagstructend
      \vskip-0.1in
      \tagstructbegin{tag=H1}\tagmcbegin{tag=H1}%
      \makebox[1.3in][l]{\dunhb \semester}{\dunhb \hfill \dunhbb \title}%
      \tagmcend\tagstructend
      \par
      \vskip 0.6em
      \begin{DecorativeBlock}\hrule height6pt\end{DecorativeBlock}
      \par
      \tagpdfparaOn
      \vskip .5em}%
  }%
}
\ExplSyntaxOn

%% 4. Questions and parts

\newcounter{accessqcount}
\newcounter{accesspartcount}

\ExplSyntaxOff

\newif\ifaccess@qtag \access@qtagfalse
\newcommand{\accessquestiontags}{\access@qtagtrue}

\newcommand{\accessqhead}[1]{%
  \ifaccess@qtag
    \accessquestionhead{#1}%
  \else
    \stepcounter{accessqcount}%
    \setcounter{accesspartcount}{0}%
    \accessbookmarkonly{2}{Question \theaccessqcount}%
    #1%
  \fi
}

\AtBeginDocument{%
  \@ifundefined{qns}{}{%
    \renewcommand{\qns}[1]{%
      \ifaccess@qtag\tagpdfparaOff\fi
      {\bf\item \accessqhead{#1}}%
      \ifaccess@qtag\par\tagpdfparaOn\fi
    }%
  }%
  \@ifundefined{q}{}{%
    \renewcommand{\q}[2]{%
      \ifaccess@qtag\tagpdfparaOff\fi
      {\bf\item (#1 pts.)\quad \accessqhead{#2}}%
      \ifaccess@qtag\par\tagpdfparaOn\fi
    }%
  }%
}

\newcommand{\accessquestionhead}[1]{%
  \stepcounter{accessqcount}%
  \setcounter{accesspartcount}{0}%
  \accessheadinginline[Question \theaccessqcount]{2}{#1}%
}

\newcommand{\accessseppart}{}
\AtBeginDocument{%
  \@ifundefined{SEP}{}{%
    \let\accessorigsep\SEP
    \renewcommand{\SEP}[1]{%
      \accessorigsep{#1}%
      \edef\accessseparg{\detokenize{#1}}%
      \edef\accessseppart{\detokenize{new_part}}%
      \ifx\accessseparg\accessseppart
        \stepcounter{accesspartcount}%
        \accessbookmarkonly{3}{Part (\alph{accesspartcount})}%
      \fi
    }%
  }%
}

\long\def\accessdiscardsarg#1{}
\newcommand{\accesspatchsolution}[2]{%
  \expandafter\let\csname accessorig#1\expandafter\endcsname\csname #1\endcsname
  \expandafter\let\expandafter\accesspatchtmp\csname accessorig#1\endcsname
  \ifx\accesspatchtmp\accessdiscardsarg
  \else
    \expandafter\renewcommand\csname #1\endcsname[1]{%
      \accessbookmarkonly{4}{#2}%
      \csname accessorig#1\endcsname{##1}%
    }%
  \fi
}

\AtBeginDocument{%
  \@ifundefined{sol}{}{\accesspatchsolution{sol}{Solution}}%
  \@ifundefined{ans}{}{\accesspatchsolution{ans}{Answer}}%
  \@ifundefined{solans}{}{\accesspatchsolution{solans}{Solution}}%
}

\ExplSyntaxOn

\endinput
