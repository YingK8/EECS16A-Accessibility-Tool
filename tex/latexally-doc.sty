%% latexally-doc.sty
%% Shared document machinery for assignments, exams and worksheets.
%% Self-contained: reproduces the EECS 16A house style without ee16.sty,
%% markup.sty or timestamp.sty.

\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesPackage{latexally-doc}[2026-08-11 v0.2.0 EECS 16A house style, tagged]

\RequirePackage{latexally-core}

\AddToHook{begindocument}{\tagpdfsetup{activate/spaces=false}}

%% 0. Options

\newif\ifaccess@housecolors \access@housecolorsfalse
\DeclareOption{housecolors}{\access@housecolorstrue}
\DeclareOption*{}
\ProcessOptions\relax

%% 1. Packages  (ee16.sty line 297 onwards)

\RequirePackage{times,mathptmx}
\RequirePackage[T1]{fontenc}
\RequirePackage{amsmath,amssymb,amsfonts,textcomp,graphicx,url}
\RequirePackage{xcolor}

\ifdefined\pdfgentounicode
  \pdfgentounicode=1
  \InputIfFileExists{glyphtounicode.tex}{}{}
\fi

%% 2. Page geometry  (ee16.sty lines 77-90, verbatim)

\textheight=9in
\textwidth=6.5in
\addtolength{\voffset}{-1in}   %%% Required when using pdflatex on Mac
\oddsidemargin=0in
\evensidemargin=-0.25in
\parindent=0pt
\parskip=5pt
\itemsep=-1pt
\floatsep 9pt plus 2pt minus 3pt
\intextsep 9pt plus 2pt minus 3pt
\textfloatsep=9pt plus 2pt minus 3pt
\renewcommand{\baselinestretch}{1.0}

\font\dunhd=cmdunh10 scaled \magstep5
\font\dunhc=cmdunh10 scaled \magstep4
\font\dunhbb=cmdunh10 scaled \magstep3
\font\dunhb=cmdunh10 scaled \magstep2
\font\dunha=cmdunh10 scaled \magstep2

%% 3. Course identity

\def\coursenumber{COURSE}
\def\class{}
\def\semester{}
\def\university{}
\def\accessdoctitle{}

\newcommand{\setcoursenumber}[1]{\def\coursenumber{#1}}
\newcommand{\setcoursename}[1]{\def\class{#1}}
\newcommand{\setsemester}[1]{\def\semester{#1}}
\newcommand{\setuniversity}[1]{\def\university{#1}}
\newcommand{\coursename}[1]{\def\class{#1}}

\providecommand{\title}{}

\providecommand{\timestamp}{\today}

%% 4. Running header and footer  (ee16.sty \ps@myheadings, verbatim)

\def\oddfoottext{\begin{footnotesize}UCB \coursenumber, \semester, \title, All
Rights Reserved. This may not be publicly shared without explicit
permission.\hfill\qquad\thepage\end{footnotesize}}
\def\evenfoottext{\begin{footnotesize}\thepage \hfill\qquad UCB \coursenumber, \semester, \title, All
Rights Reserved. This may not be publicly shared without explicit permission.\end{footnotesize}}
\def\oddheadtext{\begin{footnotesize} Last Updated: \timestamp
\hfill\qquad\thepage\end{footnotesize}}

\def\ps@myheadings{\let\@mkboth\@gobbletwo
\def\@oddfoot{\oddfoottext}%
\def\@evenfoot{\evenfoottext}%
\def\@evenhead{\oddheadtext}\def\@oddhead{\oddheadtext}}

\pagestyle{myheadings}

%% 5. Title block  (ee16.sty \maketitle / \@maketitle)

\def\maketitle{%
 \begingroup
 \newpage
 \global\@topnum\z@ \@maketitle
 \thispagestyle{myheadings}
 \endgroup
 \setcounter{footnote}{0}
 \let\maketitle\relax
 \let\@maketitle\relax}

\def\@maketitle{\newpage
\accessrecordtitle
\accessbookmarkonly{1}{\title}%
\tagpdfparaOff
\begin{Decorative}\hrule height6pt\end{Decorative} \vskip .7em
\tagstructbegin{tag=P}\tagmcbegin{tag=P}%
\makebox[1.3in][l]{\dunhb \coursenumber}{\dunhb \class \hfill \ }%
\tagmcend\tagstructend
\vskip-0.1in
\tagstructbegin{tag=H1}\tagmcbegin{tag=H1}%
\makebox[1.3in][l]{\dunhb \semester}{\dunhb \hfill \dunhbb \title}%
\tagmcend\tagstructend
\par
\vskip 0.6em
\begin{Decorative}\hrule height6pt\end{Decorative}
 \par
\tagpdfparaOn
 \vskip .5em}

\newcommand{\accessrecordtitle}{\expandafter\accesstitle\expandafter{\title}}

%% 6. Questions  (ee16.sty lines 68-69, 321-325, verbatim)

\newcounter{sparectr}
\newenvironment{qunlist}{\begin{list}{{\bf\arabic{sparectr}.}}%
                                     {\usecounter{sparectr}
                                      \setlength{\leftmargin}{0pt}}}%
                        {\end{list}}

\newcounter{accessqcount}
\newcounter{accesspartcount}

\newcommand{\accessquestionhead}[1]{%
  \stepcounter{accessqcount}%
  \setcounter{accesspartcount}{0}%
  \accessheadinginline[Question \theaccessqcount]{2}{#1}%
}

\newif\ifaccess@qtag \access@qtagfalse
\newcommand{\accessquestiontags}{\access@qtagtrue}

\newcommand{\access@qhead}[1]{%
  \ifaccess@qtag
    \accessquestionhead{#1}%
  \else
    \stepcounter{accessqcount}%
    \setcounter{accesspartcount}{0}%
    \accessbookmarkonly{2}{Question \theaccessqcount}%
    #1%
  \fi
}

\def\q#1#2{%
  \ifaccess@qtag\tagpdfparaOff\fi
  {\bf\item (#1 pts.)\quad \access@qhead{#2}}%
  \ifaccess@qtag\par\tagpdfparaOn\fi
}
\def\qns#1{%
  \ifaccess@qtag\tagpdfparaOff\fi
  {\bf\item \access@qhead{#1}}%
  \ifaccess@qtag\par\tagpdfparaOn\fi
}

%% 7. Parts

\renewcommand{\labelenumi}{(\alph{enumi})}
\renewcommand{\theenumi}{(\alph{enumi})}
\renewcommand{\labelenumii}{\roman{enumii}.}
\renewcommand{\theenumii}{\roman{enumii}.}
\renewcommand{\labelenumiii}{\Alph{enumiii}.}
\renewcommand{\theenumiii}{\Alph{enumiii}.}

\newcommand{\qitem}{%
  \item
  \stepcounter{accesspartcount}%
  \accessbookmarkonly{3}{Part (\alph{accesspartcount})}%
}

%% 8. Solutions, answers, guidance

\newif\ifaccess@showsol   \access@showsolfalse
\newif\ifaccess@showans   \access@showansfalse
\newif\ifaccess@showguid  \access@showguidfalse
\newif\ifaccess@reserve   \access@reservetrue

\newcommand{\accessshowsolutions}{\access@showsoltrue}
\newcommand{\accessshowanswers}{\access@showanstrue}
\newcommand{\accessshowguidance}{\access@showguidtrue}
\newcommand{\accessnoreserve}{\access@reservefalse}

\ifaccess@housecolors
  \definecolor{accessSolutionText}{named}{blue}
  \definecolor{accessAnswerText}{rgb}{0.2,0.2,0.9}
\else
  \colorlet{accessSolutionText}{allySolution}
  \colorlet{accessAnswerText}{allyAnswer}
\fi

\newlength{\accessreservelen}
\setlength{\accessreservelen}{5\baselineskip}
\newcommand{\accessreserve}[1]{\setlength{\accessreservelen}{#1}}

\newcommand{\access@reservespace}{%
  \ifaccess@reserve
    \begin{Decorative}\vspace*{\accessreservelen}\end{Decorative}%
  \fi
}

\newcommand{\sol}[1]{%
  \ifaccess@showsol
    \accessbookmarkonly{4}{Solution}%
    {\color{accessSolutionText}\textbf{Solution: }#1}%
  \else
    \access@reservespace
  \fi
}
\newcommand{\solans}[1]{\sol{#1}}
\newcommand{\ans}[1]{%
  \ifaccess@showans
    \accessbookmarkonly{4}{Answer}%
    {\color{accessAnswerText}\textbf{Answer: }#1}%
  \else
    \access@reservespace
  \fi
}
\newcommand{\guidance}[1]{%
  \ifaccess@showguid
    \accessbookmarkonly{4}{Guidance}%
    {\color{allyAccent}\textbf{Guidance: }#1}%
  \fi
}

\newcommand{\answer}{\smallskip\textbf{Answer:} }
\newcommand{\answerp}[1]{\smallskip\textbf{Answer:} (#1 pts.)}

%% 9. Answer regions

\newcommand{\answerbox}[1][5\baselineskip]{%
  \@ifnextchar\bgroup{\access@answerbox@braced{#1}}{\access@answerbox{#1}}%
}
\newcommand{\access@answerbox@braced}[2]{\access@answerbox{#2}}
\newcommand{\access@answerbox}[1]{%
  \par\noindent
  \begin{Described}{Blank answer box for your written response.}%
    \framebox[\linewidth]{\rule{0pt}{#1}}%
  \end{Described}%
  \par
}
\newcommand{\answerblank}[1][4cm]{%
  \@ifnextchar\bgroup{\access@answerblank@braced{#1}}{\access@answerblank{#1}}%
}
\newcommand{\access@answerblank@braced}[2]{\access@answerblank{#2}}
\newcommand{\access@answerblank}[1]{%
  \described{Blank space for your answer}{\rule{#1}{0.4pt}}%
}
\newcommand{\fillin}[1]{\answerblank[#1]}
\newcommand{\doublehrule}{%
  \begin{Decorative}\hrule \vskip 0.02in \hrule\end{Decorative}%
}

\endinput
