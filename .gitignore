__pycache__/
*.py[cod]
*.egg-info/
# Anchored to the repository root. A bare `build/` matches at ANY depth, which
# silently excluded src/latexally/build/ -- the conversion engine -- from every
# `git add -A`. The commit looked clean and the package was simply absent.
/build/
/dist/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# LaTeX build products
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.annotations
*.pdf
!docs/**/*.pdf

# Runner output. `latexally run` defaults here; keep converted copies of course
# material out of the tool repository.
/ally-out/
/examples/build/

# Cargo: the MathCAT speech driver (see src/latexally/mathspeech). Anchored,
# because vendor/MathCAT has a `target/` of its own and both belong here, but a
# bare `target/` would also swallow anything a course names that.
/mathspeech-driver/target/
/vendor/MathCAT/target/
